{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "**/*.d.ts"],
  "exclude": [
    "vite.config.*",
    "node_modules",
    "components.d.ts",
    // TODO: remove these exclusions once crypto/key tool type errors are fixed in a follow-up PR
    "src/tools/age-crypto",
    "src/tools/certificate-key-parser",
    "src/tools/csr-generator",
    "src/tools/dkim-dns-generator",
    "src/tools/ecdsa-key-pair-generator",
    "src/tools/ed25519-key-pair-generator",
    "src/tools/pgp-file-encryption",
    "src/tools/rsa-key-pair-generator",
    "src/tools/x509-certificate-generator",
    "src/tools/wireguard-config-generator",
    "src/tools/hash-text",
    "src/tools/firewalld-generator"
  ],
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["naive-ui/volar", "@intlify/unplugin-vue-i18n/messages", "unplugin-icons/types/vue", "node", "jsdom"],
    "esModuleInterop": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "allowJs": true,
    "ignoreDeprecations": "6.0"
  }
}
