  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && . ./set_node_mem.sh && vite build",
    "preview": "vite preview --port 5050",
    "test": "TZ=UTC npm run test:unit",
    "test:unit": "TZ=UTC . ./set_node_mem.sh && vitest --environment jsdom",
    "test:e2e": "TZ=UTC . ./set_node_mem.sh && playwright test",
    "test:e2e:dev": "TZ=UTC BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs",
    "script:extract:desc": "node ./scripts/extract-tools-desc.mjs",
    "script:extract:strings": "node ./scripts/extract-tools-strings.mjs",
    "script:translate-missing": "node ./scripts/translate-missings.mjs -e ./locales/en.yml -t ./locales/*.yml",
    "vue-i18n-extract": "vue-i18n-extract report --vueFiles 'src/**/*.?(ts|vue)' --languageFiles 'locales/*.yml'",
    "precommit": "pnpm install --ignore-scripts && pnpm lint:fix && pnpm typecheck"
  },
